{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "fs:default",
    "dialog:default",
    {
      "identifier": "opener:default",
      "allow": [{ "url": "**" }]
    },
    "opener:allow-reveal-item-in-dir",
    "core:path:default",
    "fs:allow-appdata-read",
    "fs:allow-appdata-write",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-exists",
    "fs:allow-mkdir",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$APPDATA/**" }, { "path": "$APPDATA" }, { "path": "**" }]
    }
  ]
}
